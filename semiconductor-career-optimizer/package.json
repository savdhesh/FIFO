{
  "name": "semiconductor-career-optimizer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node artifact/build.mjs && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "build:artifact": "node artifact/build.mjs",
    "test": "vitest run",
    "eval": "tsx eval/run.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.8.1",
    "dotenv": "^18.0.5",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.51.0",
    "mammoth": "^1.13.0",
    "next": "^15.5.27",
    "pdfkit": "^0.20.2",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^1.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.4",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vitest": "^5.0.3"
  }
}
